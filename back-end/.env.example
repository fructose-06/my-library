# UniLib Core Environment Variables
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Database Configuration
DATABASE_URL=postgresql://unilib:unilib_password@localhost:5432/unilib_db
DB_HOST=localhost
DB_PORT=5432
DB_USER=unilib
DB_PASSWORD=unilib_password
DB_NAME=unilib_db

# Security & JWT
JWT_SECRET=super-secret-unilib-jwt-key-for-development-change-in-production
JWT_EXPIRES_IN=1d

# Business Configuration
DEFAULT_TIMEZONE=Asia/Bangkok
LOG_LEVEL=info
