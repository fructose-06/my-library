{
  "openapi": "3.0.3",
  "info": {
    "title": "UniLib Core API",
    "description": "University Library Management Backend System — Production Enterprise Edition",
    "version": "1.0.0"
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {}
  },
  "paths": {
    "/health": {
      "get": {
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/tasks/expire-reservations": {
      "post": {
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "description": "User login returning JWT Bearer Token",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "identifier",
                  "password"
                ],
                "properties": {
                  "identifier": {
                    "type": "string",
                    "description": "University ID or Email"
                  },
                  "password": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "tags": [
          "Authentication"
        ],
        "description": "Get current authenticated user profile and account standing",
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/books": {
      "get": {
        "tags": [
          "Catalog"
        ],
        "description": "Search books catalog with filtering, sorting and pagination",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "query",
            "name": "query",
            "required": false
          },
          {
            "schema": {
              "type": "string"
            },
            "in": "query",
            "name": "isbn",
            "required": false
          },
          {
            "schema": {
              "type": "string"
            },
            "in": "query",
            "name": "author",
            "required": false
          },
          {
            "schema": {
              "type": "string"
            },
            "in": "query",
            "name": "category",
            "required": false
          },
          {
            "schema": {
              "type": "boolean"
            },
            "in": "query",
            "name": "available_only",
            "required": false
          },
          {
            "schema": {
              "type": "integer",
              "default": 20
            },
            "in": "query",
            "name": "limit",
            "required": false
          },
          {
            "schema": {
              "type": "integer",
              "default": 0
            },
            "in": "query",
            "name": "offset",
            "required": false
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "title",
                "created_at",
                "publication_year"
              ]
            },
            "in": "query",
            "name": "sort_by",
            "required": false
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "ASC",
                "DESC"
              ]
            },
            "in": "query",
            "name": "sort_order",
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      },
      "post": {
        "tags": [
          "Catalog"
        ],
        "description": "Create a new bibliographic book record",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "isbn",
                  "title"
                ],
                "properties": {
                  "isbn": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "publisher": {
                    "type": "string"
                  },
                  "publication_year": {
                    "type": "integer"
                  },
                  "language": {
                    "type": "string"
                  },
                  "authors": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "categories": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/books/{id}": {
      "get": {
        "tags": [
          "Catalog"
        ],
        "description": "Get book details including copies inventory",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "id",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/books/{id}/copies": {
      "post": {
        "tags": [
          "Catalog"
        ],
        "description": "Add physical copy to book inventory",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "barcode",
                  "acquisition_price"
                ],
                "properties": {
                  "barcode": {
                    "type": "string"
                  },
                  "acquisition_price": {
                    "type": "number",
                    "minimum": 0.01
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "AVAILABLE",
                      "ON_LOAN",
                      "ON_HOLD",
                      "MAINTENANCE",
                      "LOST",
                      "RETIRED"
                    ]
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "id",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/circulation/borrow": {
      "post": {
        "tags": [
          "Circulation"
        ],
        "description": "Borrow a physical book copy by barcode",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "barcode"
                ],
                "properties": {
                  "barcode": {
                    "type": "string"
                  },
                  "borrower_id": {
                    "type": "string",
                    "description": "Required if librarian borrowing on behalf of user"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/circulation/return": {
      "post": {
        "tags": [
          "Circulation"
        ],
        "description": "Process physical copy return and inspect condition (Librarian only)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "loan_id"
                ],
                "properties": {
                  "loan_id": {
                    "type": "string"
                  },
                  "condition": {
                    "type": "string",
                    "enum": [
                      "NORMAL",
                      "MINOR_DAMAGE",
                      "MAJOR_DAMAGE",
                      "UNUSABLE"
                    ],
                    "default": "NORMAL"
                  },
                  "return_date": {
                    "type": "string",
                    "format": "date-time"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/circulation/renew/{loanId}": {
      "post": {
        "tags": [
          "Circulation"
        ],
        "description": "Renew an active loan (+7 calendar days)",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "loanId",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/circulation/confirm-lost": {
      "post": {
        "tags": [
          "Circulation"
        ],
        "description": "Confirm a book is lost and apply replacement fee (Librarian only)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "loan_id"
                ],
                "properties": {
                  "loan_id": {
                    "type": "string"
                  },
                  "confirm_date": {
                    "type": "string",
                    "format": "date-time"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/circulation/my-loans": {
      "get": {
        "tags": [
          "Circulation"
        ],
        "description": "Get active loans of current authenticated user",
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/circulation/my-history": {
      "get": {
        "tags": [
          "Circulation"
        ],
        "description": "Get complete borrowing history of current authenticated user",
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/reservations/": {
      "post": {
        "tags": [
          "Reservation"
        ],
        "description": "Create a reservation for a book record",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "book_id"
                ],
                "properties": {
                  "book_id": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/reservations/{id}/cancel": {
      "post": {
        "tags": [
          "Reservation"
        ],
        "description": "Cancel an active reservation",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "id",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/reservations/my-reservations": {
      "get": {
        "tags": [
          "Reservation"
        ],
        "description": "Get all reservations of current authenticated user",
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/fines/my-fines": {
      "get": {
        "tags": [
          "Fines & Payments"
        ],
        "description": "Get fine ledger, payment history, and current outstanding balance",
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/fines/pay": {
      "post": {
        "tags": [
          "Fines & Payments"
        ],
        "description": "Receive and record fine payment (Librarian only)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "user_id",
                  "amount"
                ],
                "properties": {
                  "user_id": {
                    "type": "string"
                  },
                  "amount": {
                    "type": "number",
                    "minimum": 0.01
                  },
                  "notes": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/fines/waive": {
      "post": {
        "tags": [
          "Fines & Payments"
        ],
        "description": "Waive user fine with required justification (Admin only)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "user_id",
                  "amount",
                  "reason"
                ],
                "properties": {
                  "user_id": {
                    "type": "string"
                  },
                  "amount": {
                    "type": "number",
                    "minimum": 0.01
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 3
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/admin/users": {
      "get": {
        "tags": [
          "Administration"
        ],
        "description": "List and search users",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "query",
            "name": "search",
            "required": false
          },
          {
            "schema": {
              "type": "integer",
              "default": 20
            },
            "in": "query",
            "name": "limit",
            "required": false
          },
          {
            "schema": {
              "type": "integer",
              "default": 0
            },
            "in": "query",
            "name": "offset",
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/admin/users/{id}/status": {
      "patch": {
        "tags": [
          "Administration"
        ],
        "description": "Update user account status (ACTIVE/DISABLED) (Admin only)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "status"
                ],
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": [
                      "ACTIVE",
                      "DISABLED"
                    ]
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "id",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/admin/users/{id}/role": {
      "patch": {
        "tags": [
          "Administration"
        ],
        "description": "Update user role (Admin only)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "role"
                ],
                "properties": {
                  "role": {
                    "type": "string",
                    "enum": [
                      "STUDENT",
                      "LECTURER",
                      "LIBRARIAN",
                      "ADMIN"
                    ]
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "id",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/admin/audit-logs": {
      "get": {
        "tags": [
          "Administration"
        ],
        "description": "View system audit logs (Admin only)",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "query",
            "name": "resource_type",
            "required": false
          },
          {
            "schema": {
              "type": "string"
            },
            "in": "query",
            "name": "actor_id",
            "required": false
          },
          {
            "schema": {
              "type": "integer",
              "default": 50
            },
            "in": "query",
            "name": "limit",
            "required": false
          },
          {
            "schema": {
              "type": "integer",
              "default": 0
            },
            "in": "query",
            "name": "offset",
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/reports/overdue": {
      "get": {
        "tags": [
          "Reports"
        ],
        "description": "Generate real-time Overdue Loans Report",
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/reports/inventory": {
      "get": {
        "tags": [
          "Reports"
        ],
        "description": "Inventory Report: count of copies grouped by status",
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/reports/popular-books": {
      "get": {
        "tags": [
          "Reports"
        ],
        "description": "Most borrowed books report",
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "default": 10
            },
            "in": "query",
            "name": "limit",
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/reports/outstanding-fines": {
      "get": {
        "tags": [
          "Reports"
        ],
        "description": "List borrowers with outstanding fines",
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ]
}